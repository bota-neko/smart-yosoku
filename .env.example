# ===== Supabase =====
# Supabase プロジェクト設定 > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用（シード投入・管理操作。クライアントに絶対に露出させない）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== 外部要因 自動取得（任意。未設定なら手動入力にフォールバック） =====
# 天気: 例 OpenWeatherMap / 気象庁ラッパー等
WEATHER_API_PROVIDER=
WEATHER_API_KEY=
WEATHER_DEFAULT_LOCATION=Kagoshima,JP

# 祝日: 例 内閣府祝日CSV / Nager.Date 等
HOLIDAY_API_PROVIDER=nager
HOLIDAY_COUNTRY=JP

# ===== 納品書の読み取り（任意） =====
# Claude API キーは利用者が各自「設定」画面で登録する（費用は本人負担）。
# ここには、そのキーを暗号化して保存するための鍵を入れる（32文字以上のランダム文字列）。
# 作り方: openssl rand -base64 32
# サーバー専用。NEXT_PUBLIC_ を付けない・Git に入れない・一度決めたら変えない（変えると登録済みキーが復号できなくなる）
API_KEY_ENCRYPTION_SECRET=

# ===== アプリ =====
NEXT_PUBLIC_APP_NAME=smart-yosoku
# CSV 取込みの上限（バイト）
CSV_MAX_UPLOAD_BYTES=5242880
